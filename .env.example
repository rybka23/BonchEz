# Telegram-токен от @BotFather
BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Через запятую — telegram ID пользователей, которым разрешён доступ.
# Узнать свой ID: @userinfobot. Если оставить пустым — доступ открыт всем.
ALLOWED_USER_IDS=123456789

# Базовый URL ЛК (можно не менять)
BONCH_BASE_URL=https://lk.sut.ru

# Интервал авто-отметки в минутах (минимум 1, по умолчанию 3)
AUTO_CHECK_INTERVAL_MIN=3

# Ключ шифрования паролей (Fernet). Сгенерируйте свой:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=REPLACE_ME_WITH_FERNET_GENERATED_KEY

# Путь к SQLite-базе (по умолчанию data/bonch_bot.db)
DB_PATH=data/bonch_bot.db
